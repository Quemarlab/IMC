APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=                      # e.g. https://youngmasters.rw — auto-detected for web requests, REQUIRED for cron/CLI (links in newsletters)

DB_HOST=localhost
DB_NAME=ym
DB_USER=root
DB_PASS=

# Outgoing mail (SMTP). Use an app password, never your real mailbox password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl           # ssl | tls | none (none = local relay / test mail catcher only)
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Young Masters LTD
MAIL_TO=                      # inbox that receives contact-form notifications

# Where the UMP production system lives (shown as a shortcut in the admin sidebar for people with UMP access)
UMP_URL=                      # e.g. https://ump.youngmasters.rw
